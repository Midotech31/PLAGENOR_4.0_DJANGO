[run]
source = accounts,core,dashboard,documents,notifications,plagenor
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */__init__.py
    manage.py
    */wsgi.py
    */asgi.py
    */apps.py
    plagenor/settings.py

[report]
show_missing = False
skip_covered = False
precision = 2
# Enforced production regression floor, backed by the full Django suite.
# All measured application statements must remain covered.
fail_under = 100

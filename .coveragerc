[run]
source = accounts,core,dashboard,documents,notifications,plagenor
omit =
    */migrations/*
    */tests.py
    */__init__.py
    manage.py
    */wsgi.py
    */asgi.py
    */apps.py
    plagenor/settings.py

[report]
show_missing = False
skip_covered = False
# Floor set below the measured 50.78% to allow minor interpreter variance.
# Raise it as tests grow — never down. Guards against large coverage regressions in CI.
fail_under = 50

# =====================================================================
# Commission MSI — configuration locale
# Designed by Prof. Merzoug Mohamed
#
# Copiez ce fichier en « .env » et adaptez-le. Aucune valeur ici n'est un
# secret : les clés API éventuelles restent dans l'environnement de la
# session Windows ou dans le coffre local, jamais dans le dépôt.
# =====================================================================

# --- Répertoire de données locales -----------------------------------
# Contient la base SQLite, master.key, les documents chiffrés, les
# rapports et les sauvegardes. Ne le placez jamais sur un service cloud
# non autorisé.
MSI_DATA_DIR=./data

# --- Écoute réseau ----------------------------------------------------
# Le serveur doit rester strictement local. MSI_ALLOW_REMOTE=true est
# dangereux : l'application n'a ni compte ni mot de passe.
MSI_HOST=127.0.0.1
MSI_PORT=8731
MSI_ALLOW_REMOTE=false

# --- Import de documents ---------------------------------------------
MSI_MAX_UPLOAD_MB=120

# --- OCR local (Tesseract) -------------------------------------------
# Les langues demandées sont automatiquement restreintes à celles
# réellement installées sur le poste.
MSI_OCR_LANGUAGES=fra+ara+eng
MSI_OCR_DPI=300
MSI_OCR_LOW_CONFIDENCE=65
# Chemin explicite si Tesseract n'est pas dans le PATH :
# MSI_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Exigences de motivation humaine ---------------------------------
MSI_MIN_JUSTIFICATION=20
MSI_MIN_MOTIVATION=8

# --- Identité de l'évaluateur ----------------------------------------
MSI_EVALUATOR=Prof. Merzoug Mohamed

# =====================================================================
# Module de recherche Internet contrôlée
# =====================================================================

# Interrupteur général : à « true », aucune sortie réseau n'est possible.
# Le cœur documentaire reste entièrement utilisable.
MSI_NETWORK_DISABLED=false

# Liste blanche des domaines joignables (séparés par des virgules).
# Vérifiez les conditions d'utilisation de chaque fournisseur avant ajout.
MSI_ALLOWED_DOMAINS=api.crossref.org,api.openalex.org,pub.orcid.org,api.ror.org,doaj.org,api.datacite.org

# Désactivation individuelle d'un fournisseur, sans arrêter le reste :
# MSI_PROVIDER_OPENALEX_DISABLED=true
# MSI_PROVIDER_CROSSREF_DISABLED=true
# MSI_PROVIDER_ROR_DISABLED=true
# MSI_PROVIDER_ORCID_DISABLED=true

# Clés API éventuelles d'un fournisseur ajouté localement. Ne les écrivez
# jamais dans le code, les journaux ou une sauvegarde non protégée.
# MSI_PROVIDER_<NOM>_API_KEY=

# =====================================================================
# Traitement asynchrone durable
# =====================================================================

# Le worker d'analyse tourne dans un fil dédié, hors du fil des requêtes
# HTTP. Le mettre à « false » n'annule aucun travail : les travaux restent
# en base et repartiront au prochain démarrage.
MSI_WORKER_ENABLED=true

# =====================================================================
# Mode d'intelligence artificielle
# =====================================================================
#
# LOCAL_ONLY  : rien ne quitte le poste. Ce mode ne fournit pas le même
#               niveau de lecture sémantique ni de vérification publique.
# HYBRID_STRICT : seuls les extraits autorisés sont transmis. Le PDF
#               original, les pièces d'identité et les numéros de passeport
#               restent chiffrés en local et ne sont JAMAIS transmis — ce
#               garde-fou est appliqué dans le code, pas seulement ici.
#
# Le mode recommandé pour la fonction demandée est HYBRID_STRICT, après une
# configuration initiale unique de la clé et de l'autorisation de traitement
# externe.
#
# Sous Windows, n'editez pas ces valeurs a la main : lancez
# activer_hybrid_strict.bat, qui les pose dans l'environnement de votre
# session et vous demande la cle sans jamais l'afficher ni l'ecrire dans un
# fichier du projet. activer_local_only.bat referme tout et efface la cle.
ANALYSIS_MODE=LOCAL_ONLY

# La clé API ne doit JAMAIS être écrite dans ce fichier s'il est versionné,
# ni dans le code, ni dans une sauvegarde non protégée. Renseignez-la dans
# l'environnement de la session Windows ou dans le coffre de secrets du
# système.
# ANTHROPIC_API_KEY=

# Identifiants de modèles explicites — n'utilisez pas d'alias « latest » :
# l'identifiant exact doit apparaître dans le journal d'audit.
# ANTHROPIC_MODEL_ANALYSIS=
# ANTHROPIC_MODEL_AUDIT=

ALLOW_EXTERNAL_AI=false
SEND_ORIGINAL_PDF=false
SEND_IDENTITY_DOCUMENTS=false
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_USES=30

# Aucun traitement externe ne démarre tant que la configuration de
# confidentialité n'a pas été validée une fois.
MSI_PRIVACY_ACKNOWLEDGED=false

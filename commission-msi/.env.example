# =====================================================================
# Commission MSI — configuration locale
# Designed by Prof. Merzoug Mohamed
#
# Copiez ce fichier en « .env » et adaptez-le. Aucune valeur ici n'est un
# secret : les clés API éventuelles restent dans l'environnement de la
# session Windows ou dans le coffre local, jamais dans le dépôt.
# =====================================================================

# --- Répertoire de données locales -----------------------------------
# Contient la base SQLite, master.key, les documents chiffrés, les
# rapports et les sauvegardes. Ne le placez jamais sur un service cloud
# non autorisé.
MSI_DATA_DIR=./data

# --- Écoute réseau ----------------------------------------------------
# Le serveur doit rester strictement local. MSI_ALLOW_REMOTE=true est
# dangereux : l'application n'a ni compte ni mot de passe.
MSI_HOST=127.0.0.1
MSI_PORT=8731
MSI_ALLOW_REMOTE=false

# --- Import de documents ---------------------------------------------
MSI_MAX_UPLOAD_MB=120

# --- OCR local (Tesseract) -------------------------------------------
# Les langues demandées sont automatiquement restreintes à celles
# réellement installées sur le poste.
MSI_OCR_LANGUAGES=fra+ara+eng
MSI_OCR_DPI=300
MSI_OCR_LOW_CONFIDENCE=65
# Chemin explicite si Tesseract n'est pas dans le PATH :
# MSI_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Exigences de motivation humaine ---------------------------------
MSI_MIN_JUSTIFICATION=20
MSI_MIN_MOTIVATION=8

# --- Identité de l'évaluateur ----------------------------------------
MSI_EVALUATOR=Prof. Merzoug Mohamed

# =====================================================================
# Module de recherche Internet contrôlée
# =====================================================================

# Interrupteur général : à « true », aucune sortie réseau n'est possible.
# Le cœur documentaire reste entièrement utilisable.
MSI_NETWORK_DISABLED=false

# Liste blanche des domaines joignables (séparés par des virgules).
# Vérifiez les conditions d'utilisation de chaque fournisseur avant ajout.
MSI_ALLOWED_DOMAINS=api.crossref.org,api.openalex.org,pub.orcid.org,api.ror.org,doaj.org,api.datacite.org

# Désactivation individuelle d'un fournisseur, sans arrêter le reste :
# MSI_PROVIDER_OPENALEX_DISABLED=true
# MSI_PROVIDER_CROSSREF_DISABLED=true
# MSI_PROVIDER_ROR_DISABLED=true
# MSI_PROVIDER_ORCID_DISABLED=true

# Clés API éventuelles d'un fournisseur ajouté localement. Ne les écrivez
# jamais dans le code, les journaux ou une sauvegarde non protégée.
# MSI_PROVIDER_<NOM>_API_KEY=

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Demandeur IBTIKAR (étudiant/chercheur)"
msgstr "مُقدِّم طلب IBTIKAR (طالب/باحث)"

msgid "Client GENOCLAB (externe)"
msgstr "عميل GENOCLAB (خارجي)"

msgid "Rôle"
msgstr "الدور"

msgid "Université / Organisation"
msgstr "الجامعة / المؤسسة"

msgid "— Sélectionner —"
msgstr "— اختر —"

msgid "Type d'organisation"
msgstr "نوع المؤسسة"

msgid "Préciser (autre)"
msgstr "تحديد (أخرى)"

msgid "Pays"
msgstr "البلد"

msgid "Master (fin de cycle)"
msgstr "ماستر (سنة التخرج)"

msgid "Ingéniorat (fin de cycle)"
msgstr "مهندس دولة (سنة التخرج)"

msgid "Doctorat"
msgstr "دكتوراه"

msgid "Niveau"
msgstr "المستوى"

msgid "Laboratoire"
msgstr "المختبر"

msgid "Directeur de recherche"
msgstr "المشرف العلمي"

msgid "Identifiant IBTIKAR-DGRSDT"
msgstr "معرّف IBTIKAR-DGRSDT"

msgid "Format: IDGRSTDXXXXX"
msgstr "الصيغة: IDGRSTDXXXXX"

msgid "Téléphone"
msgstr "الهاتف"

msgid "Cet email est déjà enregistré"
msgstr "هذا البريد الإلكتروني مسجَّل مسبقاً"

msgid "Veuillez préciser le type d'organisation."
msgstr "يرجى تحديد نوع المؤسسة."

#, python-format
msgid ""
"Compte temporairement verrouillé suite à des tentatives échouées. Réessayez "
"dans %(minutes)d minute(s)."
msgstr ""
"تم قفل الحساب مؤقتًا بعد محاولات فاشلة. أعد المحاولة خلال %(minutes)d دقيقة/"
"دقائق."

msgid "Profil mis à jour."
msgstr "تم تحديث الملف الشخصي."

msgid "Email requis."
msgstr "البريد الإلكتروني مطلوب."

msgid "Vérification de votre adresse — PLAGENOR 4.0"
msgstr "التحقُّق من بريدك الإلكتروني — PLAGENOR 4.0"

#, python-format
msgid "Pour finaliser la création de votre compte, ouvrez ce lien : %(url)s"
msgstr "لإكمال إنشاء حسابك، افتح هذا الرابط: %(url)s"

msgid "Lien expiré. Veuillez recommencer."
msgstr "انتهت صلاحية الرابط. يرجى المحاولة مجدداً."

msgid "Lien invalide."
msgstr "رابط غير صالح."

msgid "Un compte avec cet email existe déjà — veuillez vous connecter."
msgstr "يوجد حساب بهذا البريد الإلكتروني مسبقاً — يرجى تسجيل الدخول."

#, python-format
msgid "Compte créé ! %(count)d demande(s) liée(s) à votre compte."
msgstr "تم إنشاء الحساب! تم ربط %(count)d طلب بحسابك."

msgid "Nouveau mot de passe"
msgstr "كلمة المرور الجديدة"

msgid "Confirmer le mot de passe"
msgstr "تأكيد كلمة المرور"

msgid "Les deux mots de passe ne correspondent pas."
msgstr "كلمتا المرور غير متطابقتين."

msgid "Votre mot de passe a été mis à jour avec succès."
msgstr "تم تحديث كلمة المرور بنجاح."

msgid "Trop de codes incorrects. Veuillez vous reconnecter."
msgstr "عدد كبير من الرموز غير الصحيحة. يرجى تسجيل الدخول مرة أخرى."

msgid "Code invalide ou expiré. Réessayez."
msgstr "رمز غير صالح أو منتهي الصلاحية. أعد المحاولة."

msgid "La double authentification est déjà activée."
msgstr "المصادقة الثنائية مفعّلة بالفعل."

msgid "Trop de codes incorrects. Veuillez recommencer."
msgstr "عدد كبير من الرموز غير الصحيحة. يرجى البدء من جديد."

msgid "Double authentification activée."
msgstr "تم تفعيل المصادقة الثنائية."

msgid "Code invalide. Vérifiez l'heure de votre appareil et réessayez."
msgstr "رمز غير صالح. تحقّق من ساعة جهازك وأعد المحاولة."

msgid "La double authentification n'est pas activée."
msgstr "المصادقة الثنائية غير مفعّلة."

msgid "Mot de passe ou code 2FA invalide."
msgstr "كلمة المرور أو رمز المصادقة الثنائية غير صحيح."

msgid "Double authentification désactivée."
msgstr "تم تعطيل المصادقة الثنائية."

msgid "Formulaire IBTIKAR"
msgstr "نموذج IBTIKAR"

msgid "Note de plateforme"
msgstr "مذكرة المنصة"

msgid "Fiche de réception"
msgstr "وثيقة الاستلام"

msgid "Devis"
msgstr "عرض الأسعار"

msgid "Vous ne pouvez pas réinitialiser votre propre compte."
msgstr "لا يمكنك إعادة تعيين حسابك الخاص."

msgid ""
"Réinitialisation annulée : ce compte ne possède pas d’adresse email vérifiée."
msgstr ""
"تم إلغاء إعادة التعيين: لا يحتوي هذا الحساب على عنوان بريد إلكتروني موثّق."

msgid "Réinitialisation de votre compte PLAGENOR 4.0"
msgstr "إعادة تعيين حسابك على PLAGENOR 4.0"

msgid ""
"Réinitialisation annulée : l’email d’instructions n’a pas pu être livré."
msgstr "تم إلغاء إعادة التعيين: تعذر تسليم رسالة التعليمات."

#, python-format
msgid "Le compte de %(username)s a été réinitialisé avec succès."
msgstr "تمت إعادة تعيين حساب %(username)s بنجاح."

msgid "Créer un compte"
msgstr "إنشاء حساب"

msgid "Créer votre compte"
msgstr "إنشاء حسابك"

msgid ""
"Convertissez votre soumission invité en un compte permanent. Pour des "
"raisons de sécurité nous vérifions d'abord votre adresse email."
msgstr ""
"حوِّل طلبك المُرسَل كزائر إلى حساب دائم. لدواعٍ أمنية، نتحقّق أولاً من بريدك "
"الإلكتروني."

msgid "Vérifiez votre messagerie"
msgstr "تحقَّق من بريدك"

#, python-format
msgid ""
"Si l'adresse <strong>%(email)s</strong> correspond à des soumissions invité, "
"un lien de vérification vient d'y être envoyé. Cliquez sur le lien pour "
"finaliser la création de votre compte."
msgstr ""
"إذا كان العنوان <strong>%(email)s</strong> مرتبطاً بطلبات أُرسِلت كزائر، فقد "
"أُرسِل إليه للتو رابط تحقُّق. انقر الرابط لإكمال إنشاء حسابك."

msgid "Le lien expire après 24 heures."
msgstr "تنتهي صلاحية الرابط بعد 24 ساعة."

msgid "Email utilisé lors de votre soumission invité"
msgstr "البريد الإلكتروني المستخدم في طلبك كزائر"

msgid "Envoyer le lien de vérification"
msgstr "إرسال رابط التحقُّق"

msgid "Vous avez déjà un compte?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Connexion"
msgstr "تسجيل الدخول"

msgid "Finaliser la création de compte"
msgstr "إكمال إنشاء الحساب"

msgid "Finaliser votre compte"
msgstr "إكمال حسابك"

msgid ""
"Votre adresse email a été vérifiée. Complétez vos informations et choisissez "
"un mot de passe."
msgstr "تم التحقُّق من بريدك الإلكتروني. أكمل معلوماتك واختر كلمة مرور."

msgid "Email vérifié"
msgstr "تم التحقُّق من البريد الإلكتروني"

msgid "Prénom"
msgstr "الاسم"

msgid "Nom"
msgstr "اللقب"

msgid "Mot de passe"
msgstr "كلمة المرور"

msgid "8 caractères minimum, non purement numérique."
msgstr "8 أحرف على الأقل، وألا تكون أرقاماً فقط."

msgid "Créer mon compte"
msgstr "إنشاء حسابي"

msgid "Réinitialisation de compte PLAGENOR 4.0"
msgstr "إعادة تعيين حساب PLAGENOR 4.0"

msgid "Plateforme de Gestion des Opérations Scientifiques"
msgstr "منصة إدارة العمليات العلمية"

msgid "Réinitialisation de votre compte"
msgstr "إعادة تعيين حسابك"

#, python-format
msgid "Bonjour %(name)s,"
msgstr "مرحباً %(name)s،"

#, python-format
msgid "Votre compte sur %(platform)s a été réinitialisé par %(admin)s."
msgstr "تمت إعادة تعيين حسابك على %(platform)s من قِبل %(admin)s."

msgid "Ce lien expire après 24 heures."
msgstr "تنتهي صلاحية هذا الرابط بعد 24 ساعة."

msgid "Ce lien ne peut être utilisé qu'une seule fois."
msgstr "لا يمكن استخدام هذا الرابط إلا مرة واحدة."

msgid "Ne partagez jamais votre mot de passe avec quiconque."
msgstr "لا تُشارك كلمة المرور مع أي شخص أبداً."

msgid "Définir le nouveau mot de passe"
msgstr "تعيين كلمة المرور الجديدة"

msgid ""
"Si vous n'étiez pas au courant de cette réinitialisation, veuillez contacter "
"immédiatement l'administrateur de la plateforme."
msgstr ""
"إذا لم تكن على علم بإعادة التعيين هذه، يرجى التواصل مع مسؤول المنصة فوراً."

msgid "Vérification de votre adresse email"
msgstr "التحقُّق من بريدك الإلكتروني"

msgid "Bonjour,"
msgstr "مرحباً،"

#, python-format
msgid ""
"Quelqu'un — vraisemblablement vous — a demandé la création d'un compte sur "
"PLAGENOR&nbsp;4.0 en utilisant l'adresse <strong>%(email)s</strong>."
msgstr ""
"طلب شخص ما — على الأرجح أنت — إنشاء حساب على PLAGENOR&nbsp;4.0 باستخدام "
"العنوان <strong>%(email)s</strong>."

msgid ""
"Pour finaliser la création de votre compte et lier vos demandes invité, "
"cliquez sur le bouton ci-dessous :"
msgstr "لإكمال إنشاء حسابك وربط طلباتك كزائر، انقر الزر أدناه:"

msgid "Vérifier mon adresse et créer mon compte"
msgstr "تحقَّق من عنواني وأنشئ حسابي"

msgid ""
"Si vous n'avez pas demandé la création d'un compte, ignorez simplement ce "
"message — aucun compte ne sera créé."
msgstr "إذا لم تطلب إنشاء حساب، فتجاهل هذه الرسالة — لن يُنشأ أي حساب."

msgid "Ne partagez jamais ce lien."
msgstr "لا تُشارك هذا الرابط مع أي شخص."

msgid ""
"Si le bouton ne fonctionne pas, copiez-collez ce lien dans votre navigateur :"
msgstr "إذا لم يعمل الزر، انسخ الرابط التالي والصقه في متصفحك:"

msgid "Réinitialisation du mot de passe"
msgstr "إعادة تعيين كلمة المرور"

msgid ""
"Vous avez demandé la réinitialisation du mot de passe de votre compte "
"PLAGENOR. Cliquez sur le bouton ci-dessous pour en choisir un nouveau."
msgstr ""
"لقد طلبت إعادة تعيين كلمة مرور حسابك في PLAGENOR. انقر على الزر أدناه "
"لاختيار كلمة مرور جديدة."

msgid "Réinitialiser mon mot de passe"
msgstr "إعادة تعيين كلمة المرور"

msgid ""
"Ce lien est valable une seule fois et expire sous peu. Si vous n'êtes pas à "
"l'origine de cette demande, ignorez cet e-mail : votre mot de passe restera "
"inchangé."
msgstr ""
"هذا الرابط صالح لمرة واحدة وينتهي قريبًا. إذا لم تكن أنت من طلب ذلك، تجاهل "
"هذا البريد: ستبقى كلمة المرور دون تغيير."

msgid "L'équipe PLAGENOR"
msgstr "فريق PLAGENOR"

msgid ""
"Bonjour,\n"
"\n"
"Vous avez demandé la réinitialisation du mot de passe de votre compte "
"PLAGENOR.\n"
"\n"
"Cliquez sur le lien ci-dessous pour choisir un nouveau mot de passe :"
msgstr ""
"مرحبًا،\n"
"\n"
"لقد طلبت إعادة تعيين كلمة مرور حسابك في PLAGENOR.\n"
"\n"
"انقر على الرابط أدناه لاختيار كلمة مرور جديدة:"

msgid ""
"Ce lien est valable une seule fois et expire sous peu. Si vous n'êtes pas à "
"l'origine de cette demande, ignorez simplement cet e-mail : votre mot de "
"passe restera inchangé.\n"
"\n"
"— L'équipe PLAGENOR"
msgstr ""
"هذا الرابط صالح لمرة واحدة وينتهي قريبًا. إذا لم تكن أنت من طلب ذلك، تجاهل "
"هذا البريد: ستبقى كلمة المرور دون تغيير.\n"
"\n"
"— فريق PLAGENOR"

msgid "Réinitialisation de votre mot de passe PLAGENOR"
msgstr "إعادة تعيين كلمة مرور PLAGENOR"

msgid "Changement de mot de passe obligatoire"
msgstr "تغيير كلمة المرور إلزامي"

msgid ""
"Votre compte a été réinitialisé. Vous devez définir un nouveau mot de passe "
"avant de continuer."
msgstr "تمت إعادة تعيين حسابك. يجب عليك تعيين كلمة مرور جديدة قبل المتابعة."

msgid "Veuillez corriger les erreurs ci-dessous."
msgstr "يرجى تصحيح الأخطاء أدناه."

msgid "Minimum 8 caractères."
msgstr "8 أحرف على الأقل."

msgid "Identifiant ou mot de passe incorrect."
msgstr "اسم المستخدم أو كلمة المرور غير صحيحة."

msgid "Identifiant"
msgstr "اسم المستخدم"

msgid "Entrez votre identifiant"
msgstr "أدخل اسم المستخدم"

msgid "Entrez votre mot de passe"
msgstr "أدخل كلمة المرور"

msgid "Afficher/masquer le mot de passe"
msgstr "إظهار/إخفاء كلمة المرور"

msgid "Se souvenir de moi"
msgstr "تذكَّرني"

msgid "Mot de passe oublié ?"
msgstr "هل نسيت كلمة المرور؟"

msgid "Se connecter"
msgstr "تسجيل الدخول"

msgid "ou"
msgstr "أو"

msgid "Pas encore de compte ?"
msgstr "ليس لديك حساب بعد؟"

msgid "Demande sans compte ?"
msgstr "طلب بدون حساب؟"

msgid "Soumettre en tant qu'invité"
msgstr "الإرسال كزائر"

msgid "Suivre une demande"
msgstr "تتبُّع طلب"

msgid "Mot de passe réinitialisé"
msgstr "تمت إعادة تعيين كلمة المرور"

msgid "Mot de passe mis à jour"
msgstr "تم تحديث كلمة المرور"

msgid ""
"Votre mot de passe a été réinitialisé avec succès. Vous pouvez maintenant "
"vous connecter."
msgstr "تمت إعادة تعيين كلمة مرورك بنجاح. يمكنك الآن تسجيل الدخول."

msgid "Choisir un nouveau mot de passe"
msgstr "اختر كلمة مرور جديدة"

msgid "Saisissez votre nouveau mot de passe deux fois."
msgstr "أدخل كلمة المرور الجديدة مرتين."

msgid "Valider"
msgstr "تأكيد"

msgid "Lien invalide"
msgstr "رابط غير صالح"

msgid ""
"Ce lien de réinitialisation n'est plus valide (déjà utilisé ou expiré). "
"Veuillez en demander un nouveau."
msgstr ""
"لم يعد رابط إعادة التعيين صالحًا (استُخدم أو انتهت صلاحيته). يرجى طلب رابط "
"جديد."

msgid "Demander un nouveau lien"
msgstr "طلب رابط جديد"

msgid "Lien envoyé"
msgstr "تم إرسال الرابط"

msgid "Vérifiez votre boîte mail"
msgstr "تحقّق من بريدك الإلكتروني"

msgid ""
"Si un compte correspond à cette adresse, un e-mail contenant les "
"instructions de réinitialisation vient d'être envoyé. Pensez à vérifier vos "
"courriers indésirables."
msgstr ""
"إذا كان هناك حساب مطابق لهذا العنوان، فقد أُرسل بريد يحتوي على تعليمات إعادة "
"التعيين. تحقّق من مجلد الرسائل غير المرغوب فيها."

msgid "Retour à la connexion"
msgstr "العودة إلى تسجيل الدخول"

msgid "Réinitialiser le mot de passe"
msgstr "إعادة تعيين كلمة المرور"

msgid ""
"Saisissez votre adresse e-mail. Si un compte existe, vous recevrez un lien "
"de réinitialisation."
msgstr ""
"أدخل عنوان بريدك الإلكتروني. إذا كان هناك حساب، ستتلقّى رابط إعادة التعيين."

msgid "Envoyer le lien"
msgstr "إرسال الرابط"

msgid "Mon Profil"
msgstr "ملفي الشخصي"

msgid "Informations personnelles"
msgstr "المعلومات الشخصية"

msgid "Photo de profil"
msgstr "الصورة الشخصية"

msgid ""
"L’adresse de connexion ne peut être modifiée qu’après vérification par un "
"administrateur."
msgstr "لا يمكن تغيير بريد تسجيل الدخول إلا بعد التحقق من قِبل مسؤول."

msgid "Organisation / Université"
msgstr "المؤسسة / الجامعة"

msgid "Langue préférée"
msgstr "اللغة المفضّلة"

msgid "Laissez vide pour utiliser la langue détectée par votre navigateur."
msgstr "اتركه فارغًا لاستخدام اللغة التي يكتشفها متصفحك."

msgid "Techniques validées"
msgstr "التقنيات المعتمدة"

msgid "Aucune technique validée. Contactez un administrateur de la plateforme."
msgstr "لا توجد تقنية معتمدة. تواصل مع مسؤول المنصة."

msgid ""
"Ces compétences contrôlent l’éligibilité aux affectations et ne sont pas "
"auto-déclarables."
msgstr "تتحكم هذه الكفاءات في أهلية الإسناد ولا يمكن التصريح بها ذاتيًا."

msgid "Mettre à jour"
msgstr "تحديث"

msgid "Sécurité — Double authentification"
msgstr "الأمان — المصادقة الثنائية"

msgid "Activée"
msgstr "مفعّلة"

msgid "Votre compte est protégé par un code à usage unique à chaque connexion."
msgstr "حسابك محمي برمز يُستخدم مرة واحدة عند كل تسجيل دخول."

msgid "Mot de passe actuel"
msgstr "كلمة المرور الحالية"

msgid "Code 2FA actuel"
msgstr "رمز المصادقة الثنائية الحالي"

msgid "Désactiver la double authentification ?"
msgstr "تعطيل المصادقة الثنائية؟"

msgid "Désactiver la 2FA"
msgstr "تعطيل 2FA"

msgid ""
"Ajoutez une couche de sécurité : un code à 6 chiffres généré par votre "
"téléphone sera demandé à la connexion. Recommandé pour les comptes du "
"personnel."
msgstr ""
"أضِف طبقة أمان: سيُطلب رمز من 6 أرقام يولّده هاتفك عند تسجيل الدخول. موصى به "
"لحسابات الموظفين."

msgid "Activer la 2FA"
msgstr "تفعيل 2FA"

msgid "Inscription"
msgstr "إنشاء حساب"

msgid "Inscrivez-vous pour soumettre des demandes d'analyses"
msgstr "أنشئ حساباً لتقديم طلبات التحاليل"

msgid ""
"Après inscription, vous serez redirigé vers le formulaire de soumission pour "
"le service"
msgstr "بعد إنشاء الحساب، ستُوجَّه إلى نموذج تقديم طلب للخدمة"

msgid "Étudiant / Chercheur"
msgstr "طالب / باحث"

msgid "Client externe"
msgstr "عميل خارجي"

msgid "Identifiant souhaité"
msgstr "اسم المستخدم المرغوب"

msgid "Précisez le type d'organisation"
msgstr "حدّد نوع المؤسسة"

msgid "Sélectionner"
msgstr "اختر"

msgid ""
"Master, Ingéniorat (fin de cycle) ou Doctorat — toutes universités "
"algériennes"
msgstr "ماستر، مهندس دولة (سنة التخرج) أو دكتوراه — جميع الجامعات الجزائرية"

msgid "Nom du laboratoire"
msgstr "اسم المختبر"

msgid "Nom du directeur de recherche"
msgstr "اسم المشرف العلمي"

msgid "optionnel"
msgstr "اختياري"

msgid "Wilaya"
msgstr "الولاية"

msgid "Sélectionnez votre wilaya"
msgstr "اختر ولايتك"

msgid "Sexe"
msgstr "الجنس"

msgid "Vous avez déjà un compte ?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Activer la double authentification"
msgstr "تفعيل المصادقة الثنائية"

msgid "Double authentification (2FA)"
msgstr "المصادقة الثنائية (2FA)"

msgid ""
"Scannez ce QR code avec une application d'authentification (Google "
"Authenticator, Authy, Microsoft Authenticator…), puis saisissez le code à 6 "
"chiffres pour confirmer."
msgstr ""

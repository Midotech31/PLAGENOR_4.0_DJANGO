msgstr ""

msgid "Formulaires officiels remplis automatiquement."
msgstr ""

msgid ""
"Le <strong>formulaire IBTIKAR</strong> est généré automatiquement, pré-"
"rempli avec vos informations et vos échantillons."
msgstr ""

